{
  "name": "opencompress-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Local browser-based shop image optimizer with Auto Best, target-size compression, SEO rename and optional reSmush.it API support.",
  "scripts": {
    "dev": "node server/index.mjs",
    "start": "node server/index.mjs --production",
    "preview": "node server/index.mjs --production",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','node_modules','.opencompress']) if (fs.existsSync(p)) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "vite": "latest",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
